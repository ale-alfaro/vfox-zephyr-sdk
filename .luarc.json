{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.1"
  },
  "workspace.ignoreDir": [
    ".vscode",
    "tests",
    "scripts"
  ],
  "diagnostics": {
    "disable": [
      "duplicate-set-field"
    ],
    "globals": [
      "Utils",
      "PLUGIN",
      "RUNTIME",
      "ZephyrSdk"
    ],
    "unusedLocalExclude": [
      "_*"
    ],
    "severity": {
    }
  },
  "workspace": {
    "checkThirdParty": true,
    "library": [
      "types",
      "lib"
    ]
  }
}
