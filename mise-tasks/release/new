#!/usr/bin/env bash
#MISE description="Open a release PR: bump metadata.lua and regenerate CHANGELOG.md with git-cliff. release.yml tags it on merge."
#USAGE flag "-n --dry-run" help="Print the version and release notes without changing anything"
set -euo pipefail

# The next version comes from the conventional commits since the last v* tag (cliff.toml [bump]).
version=$(git cliff --bumped-version)
latest_tag=$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)
if [[ $version == "$latest_tag" ]]; then
    echo "Nothing to release since $latest_tag"
    exit 0
fi
if grep -q "^## \[${version#v}\]" CHANGELOG.md 2>/dev/null; then
    echo "$version is already in CHANGELOG.md; release.yml tags it once the release PR merges"
    exit 0
fi

notes=$(git cliff --bump --unreleased --strip all)
if [[ ${usage_dry_run:-} ]]; then
    printf 'version: %s\n\n%s\n' "$version" "$notes"
    exit 0
fi

git cliff --bump -o CHANGELOG.md
# sed, not yq: yq's lua writer rewrites the file as `return {...}` and drops the PLUGIN global.
sed -i.bak "s/^\([[:space:]]*version = \)\"[^\"]*\"/\1\"${version#v}\"/" metadata.lua && rm metadata.lua.bak
[[ $(yq --input-format=lua -oy '.PLUGIN.version' metadata.lua) == "${version#v}" ]] || { echo "metadata.lua version not updated"; exit 1; }
branch=release/$version
git switch -c "$branch" 2>/dev/null || git switch "$branch"
git add CHANGELOG.md metadata.lua
git commit -m "chore: release $version"
git push -u origin "$branch"
gh pr create --title "chore: release $version" --body "$notes" \
    || gh pr edit --title "chore: release $version" --body "$notes"
